# ============================================================
# BORDERLESS — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── xStocks / Backed Finance API ────────────────────────────
#
# Used for: Live prices via GET /api/v1/collateral/quote
#
# Without this key: prices display as DEMO DATA (clearly labelled in the UI).
# Token metadata (mint addresses, logos, ISIN) is always fetched from the
# PUBLIC endpoint which requires NO key.
#
# Get your key at: https://app.backed.fi/settings/api
# Requires: an onboarded Backed / xStocks client account
#
# SECURITY: NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only
BACKED_API_KEY=

# ── Solana Network ───────────────────────────────────────────
#
# Controls the wallet adapter network configuration.
# "devnet" for development, "mainnet-beta" for production.
# Note: xStocks tokens live on Solana Mainnet. Portfolio holdings
# from a connected Devnet wallet are always labelled "DEVNET".
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
